{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "framework": "hono",
    "installCommand": "PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1 pnpm install --frozen-lockfile",
    "buildCommand": "pnpm run vercel-build",
    "env": {
        "NODE_OPTIONS": "--experimental-require-module",
        "CACHE_TYPE": "memory",
        "CACHE_EXPIRE": "3600",
        "DISALLOW_ROBOT": "true"
    },
    "outputDirectory": "src",
    "functions": {
        "src/server.mjs": {
            "includeFiles": "node_modules/.pnpm/patchright-core@*/node_modules/patchright-core/**"
        }
    },
    "rewrites": [
        {
            "source": "/favicon.ico",
            "destination": "/favicon.png"
        }
    ],
    "github": {
        "silent": true
    }
}
